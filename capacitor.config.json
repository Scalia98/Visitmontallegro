{
  "appId": "it.visitmontallegrobovomarina.infoapp",
  "appName": "Visit Montallegro Bovo Marina",
  "webDir": "www",
  "backgroundColor": "#F3F5F7",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F3F5F7"
  },
  "android": {
